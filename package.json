{
  "name": "free-food-map",
  "version": "1.1.0",
  "private": true,
  "description": "Global free food distribution map. Inspired by Xiao Tang in LA. Bilingual (zh/en).",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i tailwind.src.css -o tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i tailwind.src.css -o tailwind.css --watch",
    "dev": "python -m http.server 8000"
  },
  "devDependencies": {
    "tailwindcss": "3.4.0"
  }
}
